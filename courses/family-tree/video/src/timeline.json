 "captions": [
  {
   "t0": 0.4,
   "t1": 4,
   "text": "大家好，我是“我”！"
  },
  {
   "t0": 4,
   "t1": 9.3,
   "text": "过年了，家里来了好多亲戚。他们该怎么叫呢？"
  },
  {
   "t0": 9.5,
   "t1": 15,
   "text": "跟我一起，从“我”出发，去找家人吧！"
  },
  {
   "t0": 15.2,
   "t1": 19.6,
   "text": "我有爸爸，也有妈妈。"
  },
  {
   "t0": 19.6,
   "t1": 24.2,
   "text": "家人分成两边：爸爸这边，和妈妈这边。"
  },
  {
   "t0": 24.2,
   "t1": 28,
   "text": "先去爸爸这边看看！"
  },
  {
   "t0": 28,
   "t1": 32.6,
   "text": "爸爸的爸爸，叫爷爷；"
  },
  {
   "t0": 32.6,
   "t1": 38.2,
   "text": "爸爸的妈妈，叫奶奶。"
  },
  {
   "t0": 38.6,
   "t1": 44.2,
   "text": "爷爷奶奶不只有爸爸一个孩子哦！"
  },
  {
   "t0": 44.6,
   "t1": 52.2,
   "text": "比爸爸大的哥哥，我叫他伯伯。"
  },
  {
   "t0": 52.6,
   "t1": 59.6,
   "text": "比爸爸小的弟弟，我叫他叔叔。"
  },
  {
   "t0": 60,
   "t1": 66,
   "text": "爸爸的姐姐和妹妹，我都叫她姑姑。"
  },
  {
   "t0": 66.5,
   "t1": 73.2,
   "text": "叔叔家有个男孩。我该叫他什么呢？"
  },
  {
   "t0": 73.4,
   "t1": 83,
   "text": "从我出发，走到叔叔家。叔叔是爸爸的兄弟，所以是「堂」。"
  },
  {
   "t0": 83,
   "t1": 89.4,
   "text": "他比我大，是哥哥。"
  },
  {
   "t0": 89.4,
   "t1": 95.6,
   "text": "叔叔的儿子比我大，我叫他「堂」哥！"
  },
  {
   "t0": 96,
   "t1": 99.6,
   "text": "姑姑家的妹妹，我知道！"
  },
  {
   "t0": 99.6,
   "t1": 103,
   "text": "是……「堂」妹！"
  },
  {
   "t0": 103,
   "t1": 110.4,
   "text": "哎呀，说错啦！姑姑是爸爸的姐妹，不是兄弟，所以是『表』。"
  },
  {
   "t0": 110.4,
   "t1": 114.2,
   "text": "她比我小，是妹妹。"
  },
  {
   "t0": 114.2,
   "t1": 119.2,
   "text": "姑姑的女儿比我小，我叫她『表』妹。"
  },
  {
   "t0": 119.6,
   "t1": 124.6,
   "text": "停一停！伯伯的女儿比我大，叫什么？"
  },
  {
   "t0": 124.6,
   "t1": 129.6,
   "text": "大声说出来！"
  },
  {
   "t0": 129.6,
   "t1": 133.4,
   "text": "「堂」姐！你答对了吗？"
  },
  {
   "t0": 134,
   "t1": 141.6,
   "text": "现在去妈妈这边！我还是我，只是换个方向看。"
  },
  {
   "t0": 142,
   "t1": 146.4,
   "text": "妈妈的爸爸，叫外公；"
  },
  {
   "t0": 146.4,
   "t1": 150.6,
   "text": "妈妈的妈妈，叫外婆。"
  },
  {
   "t0": 150.8,
   "t1": 155,
   "text": "妈妈的兄弟，叫舅舅；"
  },
  {
   "t0": 155,
   "t1": 159,
   "text": "妈妈的姐妹，叫姨妈。"
  },
  {
   "t0": 159.2,
   "t1": 165.6,
   "text": "舅舅家有个女孩。走一走：舅舅是妈妈的兄弟，也是『表』！"
  },
  {
   "t0": 165.6,
   "t1": 169.8,
   "text": "她比我大，是姐姐。"
  },
  {
   "t0": 169.8,
   "t1": 173.8,
   "text": "舅舅的女儿比我大，我叫她『表』姐。"
  },
  {
   "t0": 174,
   "t1": 180,
   "text": "姨妈家有个男孩，走一走，也是『表』。"
  },
  {
   "t0": 180,
   "t1": 183.8,
   "text": "他比我小，是弟弟。"
  },
  {
   "t0": 183.8,
   "t1": 188,
   "text": "姨妈的儿子比我小，我叫他『表』弟。"
  },
  {
   "t0": 188.2,
   "t1": 194.4,
   "text": "妈妈这边的孩子，都叫『表』。"
  },
  {
   "t0": 194.6,
   "t1": 199.6,
   "text": "停一停！舅舅的儿子比我小，叫什么？"
  },
  {
   "t0": 199.6,
   "t1": 204.6,
   "text": "大声说出来！"
  },
  {
   "t0": 204.6,
   "t1": 208.4,
   "text": "『表』弟！你答对了吗？"
  },
  {
   "t0": 209,
   "t1": 216.8,
   "text": "爸爸这边，妈妈这边，中间都是同一个我。"
  },
  {
   "t0": 217,
   "t1": 221.6,
   "text": "橙色的路，只经过爸爸的兄弟：伯伯和叔叔。"
  },
  {
   "t0": 221.6,
   "t1": 227.2,
   "text": "其他的路，都是青色的『表』。"
  },
  {
   "t0": 230.4,
   "t1": 235.20000000000002,
   "text": "爸爸兄弟家，孩子叫「堂」；",
   "chant": true
  },
  {
   "t0": 235.20000000000002,
   "t1": 240.00000000000003,
   "text": "别的亲戚家，孩子都叫『表』；",
   "chant": true
  },
  {
   "t0": 240.00000000000003,
   "t1": 244.80000000000004,
   "text": "比我大，叫哥姐；",
   "chant": true
  },
  {
   "t0": 244.80000000000004,
   "t1": 249.60000000000005,
   "text": "比我小，叫弟妹。",
   "chant": true
  },
  {
   "t0": 251.0,
   "t1": 257.0,
   "text": "第1关！姑姑的儿子，比我大，叫什么？"
  },
  {
   "t0": 257.0,
   "t1": 262.0,
   "text": "大声说出来！"
  },
  {
   "t0": 262.0,
   "t1": 267.0,
   "text": "『表』哥！姑姑家是『表』，比我大是哥。"
  },
  {
   "t0": 267.2,
   "t1": 273.2,
   "text": "第2关！叔叔的女儿，比我小，叫什么？"
  },
  {
   "t0": 273.2,
   "t1": 278.2,
   "text": "大声说出来！"
  },
  {
   "t0": 278.2,
   "t1": 283.2,
   "text": "「堂」妹！叔叔家是「堂」，比我小是妹。"
  },
  {
   "t0": 283.4,
   "t1": 289.4,
   "text": "第3关！姨妈的女儿，比我大，叫什么？"
  },
  {
   "t0": 289.4,
   "t1": 294.4,
   "text": "大声说出来！"
  },
  {
   "t0": 294.4,
   "t1": 299.4,
   "text": "『表』姐！姨妈家是『表』，比我大是姐。"
  },
  {
   "t0": 299.4,
   "t1": 302.6,
   "text": "三关全过，你真棒！"
  },
  {
   "t0": 302.6,
   "t1": 314.4,
   "text": "「堂」、『表』、哥、姐、弟、妹，我们一起读一读。"
  },
  {
   "t0": 314.6,
   "t1": 321.4,
   "text": "回家问问爸爸妈妈，画一画你的家庭树吧！"
  }
 ],
