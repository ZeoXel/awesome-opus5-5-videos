 "captions": [
  {
   "t0": 0.6,
   "t1": 6.6,
   "text": "上一集，我们认识了兄弟足球队。"
  },
  {
   "t0": 6.8,
   "t1": 13.6,
   "text": "伯伯、叔叔家的孩子是小队员，叫「堂」；"
  },
  {
   "t0": 13.8,
   "t1": 21.4,
   "text": "姑姑家的孩子不是，叫『表』。"
  },
  {
   "t0": 31,
   "t1": 39.6,
   "text": "妈妈的爸爸妈妈，名字前面加一个“外”字。"
  },
  {
   "t0": 66.2,
   "t1": 71,
   "text": "妈妈的兄弟，叫舅舅。"
  },
  {
   "t0": 90.6,
   "t1": 95.6,
   "text": "妈妈的姐妹，叫姨妈。"
  },
  {
   "t0": 103.2,
   "t1": 108.6,
   "text": "妈妈这边，没有兄弟足球队！"
  },
  {
   "t0": 108.8,
   "t1": 114,
   "text": "所以，妈妈这边的孩子，都叫『表』！"
  },
  {
   "t0": 146,
   "t1": 151.4,
   "text": "妈妈这边，也贴满啦！"
  },
  {
   "t0": 157.4,
   "t1": 164,
   "text": "爸爸这边，妈妈这边，中间都是同一个我！"
  },
  {
   "t0": 164.6,
   "t1": 171,
   "text": "下一集：拍全家福！"
  }
 ],
