 "lines": [
  {
   "id": "hello",
   "who": "C",
   "text": "过年啦，我来认一认家里人。",
   "t0": 2.4,
   "dur": 2.845,
   "show": 3.944
  },
  {
   "id": "q_yeye",
   "who": "T",
   "text": "爸爸的爸爸，叫什么？",
   "t0": 7.745,
   "dur": 2.039,
   "show": 3.278
  },
  {
   "id": "a_yeye",
   "who": "C",
   "text": "爸爸的爸爸，叫爷爷。",
   "t0": 10.134,
   "dur": 2.057,
   "show": 3.278
  },
  {
   "id": "q_nainai",
   "who": "T",
   "text": "爸爸的妈妈，叫什么？",
   "t0": 13.191,
   "dur": 2.079,
   "show": 3.278
  },
  {
   "id": "a_nainai",
   "who": "C",
   "text": "爸爸的妈妈，叫奶奶。",
   "t0": 15.62,
   "dur": 2.243,
   "show": 3.278
  },
  {
   "id": "q_bobo",
   "who": "T",
   "text": "爸爸的哥哥，叫什么？",
   "t0": 18.863,
   "dur": 2.111,
   "show": 3.278
  },
  {
   "id": "a_bobo",
   "who": "C",
   "text": "爸爸的哥哥，叫伯伯。",
   "t0": 21.324,
   "dur": 2.223,
   "show": 3.278
  },
  {
   "id": "q_shushu",
   "who": "T",
   "text": "爸爸的弟弟，叫什么？",
   "t0": 24.547,
   "dur": 2.035,
   "show": 3.278
  },
  {
   "id": "a_shushu",
   "who": "C",
   "text": "爸爸的弟弟，叫叔叔。",
   "t0": 26.932,
   "dur": 2.038,
   "show": 3.278
  },
  {
   "id": "q_gugu",
   "who": "T",
   "text": "爸爸的姐姐妹妹，叫什么？",
   "t0": 29.97,
   "dur": 3.143,
   "show": 3.743
  },
  {
   "id": "a_gugu",
   "who": "C",
   "text": "爸爸的姐姐妹妹，叫姑姑。",
   "t0": 33.463,
   "dur": 2.402,
   "show": 3.722
  },
  {
   "id": "q_waigong",
   "who": "T",
   "text": "妈妈的爸爸，叫什么？",
   "t0": 41.565,
   "dur": 1.949,
   "show": 3.278
  },
  {
   "id": "a_waigong",
   "who": "C",
   "text": "妈妈的爸爸，叫外公。",
   "t0": 43.864,
   "dur": 2.066,
   "show": 3.278
  },
  {
   "id": "q_waipo",
   "who": "T",
   "text": "妈妈的妈妈，叫什么？",
   "t0": 46.93,
   "dur": 1.983,
   "show": 3.278
  },
  {
   "id": "a_waipo",
   "who": "C",
   "text": "妈妈的妈妈，叫外婆。",
   "t0": 49.263,
   "dur": 2.193,
   "show": 3.278
  },
  {
   "id": "q_jiujiu",
   "who": "T",
   "text": "妈妈的哥哥弟弟，叫什么？",
   "t0": 52.456,
   "dur": 3.055,
   "show": 3.722
  },
  {
   "id": "a_jiujiu",
   "who": "C",
   "text": "妈妈的哥哥弟弟，叫舅舅。",
   "t0": 55.861,
   "dur": 2.816,
   "show": 3.722
  },
  {
   "id": "q_yima",
   "who": "T",
   "text": "妈妈的姐姐妹妹，叫什么？",
   "t0": 59.677,
   "dur": 2.623,
   "show": 3.722
  },
  {
   "id": "a_yima",
   "who": "C",
   "text": "妈妈的姐姐妹妹，叫姨妈。",
   "t0": 62.65,
   "dur": 2.597,
   "show": 3.722
  },
  {
   "id": "k_tangge",
   "who": "C",
   "text": "叔叔的儿子比我大，我叫他堂哥。",
   "t0": 69.847,
   "dur": 3.361,
   "show": 4.389
  },
  {
   "id": "k_biaomei",
   "who": "C",
   "text": "姑姑的女儿比我小，我叫她表妹。",
   "t0": 75.208,
   "dur": 3.08,
   "show": 4.389
  },
  {
   "id": "k_biaojie",
   "who": "C",
   "text": "舅舅的女儿比我大，我叫她表姐。",
   "t0": 80.288,
   "dur": 3.098,
   "show": 4.389
  },
  {
   "id": "k_biaodi",
   "who": "C",
   "text": "姨妈的儿子比我小，我叫他表弟。",
   "t0": 85.386,
   "dur": 3.32,
   "show": 4.389
  },
  {
   "id": "q_tang",
   "who": "T",
   "text": "什么时候，叫“堂”呢？",
   "t0": 90.306,
   "dur": 2.081,
   "show": 3.056
  },
  {
   "id": "a_tang",
   "who": "C",
   "text": "爸爸的兄弟，伯伯、叔叔家的孩子，叫堂。",
   "t0": 92.787,
   "dur": 4.304,
   "show": 4.904
  },
  {
   "id": "q_biao",
   "who": "T",
   "text": "别人家的孩子呢？",
   "t0": 98.191,
   "dur": 2.113,
   "show": 3.056
  },
  {
   "id": "a_biao",
   "who": "C",
   "text": "姑姑、舅舅、姨妈家的孩子，都叫表。",
   "t0": 100.704,
   "dur": 3.855,
   "show": 4.455
  },
  {
   "id": "q_order",
   "who": "T",
   "text": "哥哥姐姐，弟弟妹妹，怎么分？",
   "t0": 105.659,
   "dur": 3.006,
   "show": 3.944
  },
  {
   "id": "a_order",
   "who": "C",
   "text": "比我大，叫哥哥姐姐；比我小，叫弟弟妹妹。",
   "t0": 109.065,
   "dur": 4.385,
   "show": 5.056
  },
  {
   "id": "same",
   "who": "C",
   "text": "两边的我，是同一个我。",
   "t0": 120.55,
   "dur": 2.244,
   "show": 3.5
  },
  {
   "id": "bye_c",
   "who": "C",
   "text": "过年好！",
   "t0": 126.594,
   "dur": 0.89,
   "show": 2.167
  },
